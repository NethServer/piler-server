# cp .env.example .env, edit, docker compose up -d
# Compose reads .env from this directory. It is gitignored. Every value below
# is the default, so the stack starts fine with no .env at all.


## Read by compose, never reaches a container

# Image to run. ./build-images.sh tags your own build under this name.
#PILER_IMAGE=ghcr.io/nethserver/piler-server:latest

# Host side of the published ports. The container keeps its own.
#HOST_SMTP_PORT=25
#HOST_HTTP_PORT=80


## Passed to the piler container

# Archive identity: piler's hostid, the nginx server_name, the UI site name.
# Mail is stored under it, so set it before the first start. Not the
# self-signed certificate's CN, which is a fixed placeholder.
PILER_HOSTNAME=archive.example.com

# Shared by the mariadb and piler containers, so one value covers both.
# Set it BEFORE the first start: mariadb only applies it while initialising
# its data directory, and a later change locks piler out of its own database.
# Recovering means docker compose down -v, which destroys the archive.
# No '%' in it: piler's cron scripts parse piler.conf with configparser and
# the nightly purge dies on the interpolation.
MYSQL_PASSWORD=piler123

# Point these at an external database and the bundled mysql service goes
# unused. MYSQL_DATABASE and MYSQL_USER are read by both containers.
#MYSQL_HOSTNAME=mysql
#MYSQL_PORT=3306
#MYSQL_DATABASE=piler
#MYSQL_USER=piler

# 5-second probes before the start gives up waiting for the database.
#MYSQL_WAIT_MAX_ATTEMPTS=60

# MANTICORE_PORT and MANTICORE_PORT_READONLY only tell piler where to connect.
# Manticore's own listeners are hardcoded in config/manticore.conf, so a
# change here needs the matching edit there or the search breaks.
#MANTICORE_HOSTNAME=manticore
#MANTICORE_PORT=9306
#MANTICORE_PORT_READONLY=9307

#MEMCACHED_HOSTNAME=memcached
#MEMCACHED_PORT=11211

# Keep archiving the spool on a graceful stop. The timeout must stay below
# the stop_grace_period in docker-compose.yml, or the container is SIGKILLed
# mid-spool and the mail in flight is lost.
#PILER_STOP_DRAIN=1
#PILER_STOP_DRAIN_TIMEOUT=300
#PILER_STOP_DRAIN_INTERVAL=2

# Bare path, no quotes, for serving the UI under a prefix. Not enough alone:
# SITE_URL, BRANDING_LOGO, BRANDING_FAVICON and SITE_LOGO_LG stay at the root
# and the entrypoint sets none of them. A stale SITE_URL sends the browser
# out of the prefix right after login.
#PATH_PREFIX=/archive/

# Replaces admin@local's hash when the schema is created, so the first start
# does not leave the documented demo password in place. Read at schema
# creation only. Leave it commented out rather than empty: an empty value
# writes an empty hash and locks the account out.
#ADMIN_USER_PASSWORD_HASH=


## Not settable here
#
# RT         - only 1 works; with no indexer in the image, batch mode cannot
#              build or rotate an index and the start aborts.
# PILER_USER - the uid is baked into the image and pinned by user: in
#              docker-compose.yml; changing one alone breaks the file owners.
#
# CONFIG_DIR, TMP_CONF_DIR and PILER_JS are overridable, but only so
# tests/entrypoint-config-test.sh can run the entrypoint against a scratch
# directory. Every other config path derives from CONFIG_DIR.
